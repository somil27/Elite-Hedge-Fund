# ═══════════════════════════════════════════════════════════════
# AlphaDesk — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider ───────────────────────────────────────────────
# Set ANY ONE key — the system handles everything else automatically.
# You do NOT need more than one key.
#
# ANTHROPIC_API_KEY  → Claude for all agents
#                      Embeddings: Gemini public free API (no key needed)
#                      Optional: add GEMINI_API_KEY for higher embed rate limits
#
# OPENAI_API_KEY     → GPT-4o for all agents + OpenAI embeddings
#
# GEMINI_API_KEY     → Gemini for all agents + Gemini embeddings
#
# Priority if multiple keys set: Anthropic > OpenAI > Gemini
# Force a specific one: LLM_PROVIDER=anthropic|openai|gemini

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# ── Observability (LangSmith) ──────────────────────────────────
# Set these to trace all AI agent decisions in LangSmith UI
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=alphadesk

# ── Database ───────────────────────────────────────────────────
# Inside Docker: host = 'postgres' (Docker service name)
# Local dev without Docker: host = 'localhost'
DATABASE_URL=postgresql+asyncpg://trader:trader_pass@postgres:5432/trading_system
DATABASE_URL_SYNC=postgresql://trader:trader_pass@postgres:5432/trading_system

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Broker Selection ───────────────────────────────────────────
# Options: mock | alpaca | ibkr
# mock = no API keys needed (default — good for dev/testing)
BROKER=mock
ALPACA_PAPER=true

# Mock broker settings
MOCK_INITIAL_CASH=100000.0
MOCK_SLIPPAGE_BPS=2.0

# ── Alpaca (US paper/live trading) ─────────────────────────────
# Get keys at: https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Interactive Brokers ────────────────────────────────────────
# Requires TWS or IB Gateway running locally
# IBKR_PAPER=true
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497

# ── Zerodha Kite Connect (Indian market) ───────────────────────
# Get keys at: https://developers.kite.trade
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URI=http://localhost:8000/api/india/zerodha/callback

# ── Upstox v2 (Indian market) ──────────────────────────────────
# Get keys at: https://developer.upstox.com
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/india/upstox/callback

# ── Market Data ────────────────────────────────────────────────
# Optional: Polygon.io for production-grade US market data
# Falls back to yfinance if not set
POLYGON_API_KEY=

# ── App ────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-32-char-string
FRONTEND_URL=http://localhost:5173
